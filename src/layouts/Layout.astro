---
import "../styles/global.css";
import { getCollection } from "astro:content";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Faithful in the everyday. Church-centered discipleship and practical life skills, founded on Jesus Christ.",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const challengeIds = (await getCollection("challenges"))
  .filter((c) => c.data.level === "Apprentice")
  .map((c) => c.id);
const links = [
  ["My Workshop", "my-workshop"],
  ["Challenges", "challenges"],
  ["Foundation 7", "foundation-7"],
  ["How It Works", "how-it-works"],
  ["Resources", "resources"],
  ["For the Church", "for-the-church"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | Foundation Framework</title>
    <link rel="icon" href={`${base}favicon.svg`} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Set before paint; theme preference is separate from challenge progress.
      let theme;
      try {
        theme = localStorage.getItem("foundation-framework:theme");
      } catch {}
      document.documentElement.dataset.theme =
        theme === "light" || theme === "dark"
          ? theme
          : window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header>
      <div class="header-inner">
        <a class="brand" href={base}>
          <img
            class="icon brand-logo"
            src={`${base}brand/mark.svg`}
            width="35"
            height="35"
            alt=""
          />
          <span>
            FOUNDATION<small>FRAMEWORK</small>
          </span>
        </a>
        <div class="theme-switch" role="group" aria-label="Color theme">
          <button data-theme-choice="light" aria-pressed="false">
            Light
          </button>
          <button data-theme-choice="dark" aria-pressed="false">
            Dark
          </button>
        </div>
        <button
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="navigation"
        >
          Menu
        </button>
        <nav id="navigation" aria-label="Main">
          {links.map(([label, path]) => (
            <a
              href={`${base}${path}/`}
              aria-current={
                Astro.url.pathname.includes(`/${path}/`) ? "page" : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" data-challenge-ids={JSON.stringify(challengeIds)}>
      <slot />
    </main>
    <footer>
      <div>
        <strong>FOUNDATION FRAMEWORK</strong>
        <p>Faithful in the everyday.</p>
        <a href={`${base}#foundation`}>1 Corinthians 3:11</a>
      </div>
      <div>
        <a href={`${base}downloads/`}>Brand & printables</a>
        <a href={`${base}pillars/`}>Four pillars</a>
        <a href={`${base}levels/`}>Three levels</a>
        <span>v0.1 · Sample curriculum</span>
      </div>
    </footer>
    <script>
      import "../scripts/progress";
      import "../scripts/theme";
      const b = document.querySelector<HTMLButtonElement>("#menu-toggle");
      b?.addEventListener("click", () => {
        const open = b.getAttribute("aria-expanded") !== "true";
        b.setAttribute("aria-expanded", String(open));
        document.querySelector("#navigation")?.classList.toggle("open", open);
      });
    </script>
  </body>
</html>
