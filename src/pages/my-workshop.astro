---
import Layout from "../layouts/Layout.astro";
import ProgressData from "../components/ProgressData.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="My Workshop">
  <ProgressData />
  <section class="page-intro">
    <span class="eyebrow">Apprentice · Your working record</span>
    <h1>My Workshop</h1>
    <p>
      Pick up where you left off. Arrange help, practice, and bring your work to
      someone who can give useful feedback.
    </p>
    <p class="device-note">
      This record stays in this browser. Ready for sign-off means ready for an
      adult review, not approved completion.
    </p>
  </section>

  <section class="workshop-overview" aria-label="Apprentice overview">
    <div>
      <h2>Your foundation</h2>
      <p data-progress-summary></p>
      <progress
        data-overall
        max="16"
        value="0"
        aria-label="Challenges ready for sign-off"
      ></progress>
    </div>
    <div data-pillar-coverage class="coverage"></div>
  </section>
  <section class="workshop-board" aria-label="Challenge workbench">
    <section class="board-lane">
      <div class="lane-heading">
        <span class="eyebrow">01 · Find a starting point</span>
        <h2>
          Choose next <span data-lane-count="choose"></span>
        </h2>
      </div>
      <p class="lane-help">
        A few optional Foundation 7 suggestions. Begin anywhere.
      </p>
      <div data-choose-next class="lane-cards"></div>
      <p data-choose-empty hidden>
        All seven are underway or ready. Explore the full catalog for your next
        challenge.
      </p>
      <a class="lane-footer" href={`${base}challenges/`}>
        Explore all challenges
      </a>
    </section>
    <section class="board-lane">
      <div class="lane-heading">
        <span class="eyebrow">02 · Learn and practice</span>
        <h2>
          Working on <span data-lane-count="working"></span>
        </h2>
      </div>
      <p class="lane-help">Pick up at your next unchecked step.</p>
      <div data-workbench class="lane-cards"></div>
      <p data-workbench-empty>Start a challenge to put it on your workbench.</p>
    </section>
    <section class="board-lane">
      <div class="lane-heading">
        <span class="eyebrow">03 · Show what you learned</span>
        <h2>
          Ready to demonstrate <span data-lane-count="ready"></span>
        </h2>
      </div>
      <p class="lane-help">
        Bring your work to an appropriate adult. Readiness is not approved
        completion.
      </p>
      <div data-review-list class="lane-cards"></div>
      <p data-review-empty>Finish a checklist to bring a challenge here.</p>
    </section>
  </section>
  <p class="board-note">
    Cards move as you start work and complete checklists. No dragging needed.{" "}
    <a href={`${base}foundation-7/`}>About Foundation 7</a>
  </p>
  <section class="local-note">
    <a class="button secondary" href={`${base}completion-record/`}>
      Print your progress record
    </a>
    <button data-reset-progress>Reset prototype progress</button>
    <p data-storage-message role="status"></p>
  </section>
  <noscript>
    <p>
      Local progress requires JavaScript. You can still{" "}
      <a href={`${base}challenges/`}>read and print every challenge</a>.
    </p>
  </noscript>
  <script>
    import "../scripts/workshop";
  </script>
</Layout>
